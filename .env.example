# Required in every deployment.
# DEPLOYMENT_MODE: shared | dedicated
# DATABASE_URL: use sslmode=require in production
# JWT_SECRET: >= 32 chars; unique per deployment
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whitelabel_dev
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# --- Shared deployment (one instance serves many tenants via X-Client-Id) ---
DEPLOYMENT_MODE=shared

# --- Dedicated deployment (one tenant; slug must exist in the DB at startup) ---
# DEPLOYMENT_MODE=dedicated
# DEDICATED_TENANT_SLUG=acme

# Optional (defaults shown)
# JWT_ISSUER=whitelabel-api
# ACCESS_TOKEN_TTL_SECONDS=900        # 60-3600
# REFRESH_SESSION_TTL_DAYS=30         # 1-365
# PASSWORD_RESET_TTL_MINUTES=30       # 5-1440
# TRUST_PROXY=false                   # true: client IP from first X-Forwarded-For hop
# LOG_LEVEL=info
# MAILER=console                      # logs reset links only when NODE_ENV != production
# MAX_BODY_BYTES=65536

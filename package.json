{
  "name": "whitelabel-backend-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:int:shared": "vitest run --project integration-shared --passWithNoTests",
    "test:int:dedicated": "vitest run --project integration-dedicated --passWithNoTests",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset:test": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whitelabel_test_shared prisma migrate reset --force && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whitelabel_test_dedicated prisma migrate reset --force",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:lint": "redocly lint openapi/openapi.yaml",
    "tenant": "tsx scripts/tenant.ts",
    "postinstall": "prisma generate",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
